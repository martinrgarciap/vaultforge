APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://vaultforge:vaultforge_local_dev@localhost:5433/vaultforge?sslmode=disable
REDIS_URL=redis://127.0.0.1:6380/0
TEST_REDIS_URL=redis://127.0.0.1:6380/1
REDIS_DIAL_TIMEOUT=2s
REDIS_READ_TIMEOUT=1s
REDIS_WRITE_TIMEOUT=1s
REDIS_POOL_TIMEOUT=2s
ACCESS_TOKEN_ISSUER=vaultforge-api
ACCESS_TOKEN_AUDIENCE=vaultforge-api
ACCESS_TOKEN_KEY_ID=local-ed25519-v1
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=720h
ACCESS_TOKEN_CLOCK_LEEWAY=30s

# Generate locally with: openssl rand -base64 32
ACCESS_TOKEN_ED25519_SEED_BASE64=

# Generate locally with: openssl rand -base64 32
RATE_LIMIT_IDENTITY_HMAC_KEY_BASE64=

RATE_LIMIT_REGISTRATION_REQUESTS=5
RATE_LIMIT_REGISTRATION_WINDOW=10m
RATE_LIMIT_LOGIN_REQUESTS=20
RATE_LIMIT_LOGIN_WINDOW=1m
RATE_LIMIT_REFRESH_REQUESTS=30
RATE_LIMIT_REFRESH_WINDOW=1m
RATE_LIMIT_MUTATION_REQUESTS=60
RATE_LIMIT_MUTATION_WINDOW=1m

LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW=15m
LOGIN_LOCKOUT_DURATION=15m
